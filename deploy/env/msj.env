# Non-secret environment shared by msj-serve, msj-worker, msj-migrate and
# msj-cli. Installed to /etc/msj/msj.env (root:msj 0640) by bootstrap.sh.
# Secrets (RUNPOD_API_KEY) are in /srv/msj/secrets/app.env, on the encrypted
# volume, never here.
MSJ_CONFIG_FILE=/etc/msj/config.toml
MSJ_DATA_DIR=/srv/msj/data
MSJ_WEB_DIR=/opt/msj/current/web
# Model cache on the boot disk: public, re-downloadable weights with nothing
# private in them. Read-only to the services.
HF_HOME=/var/lib/msj/hf
# Never contact the Hugging Face Hub at runtime; the weights are fetched once
# by bootstrap.sh (msj embedding-download). A missing model then fails with
# EMBEDDING_MODEL_LOAD_FAILED instead of a silent download.
HF_HUB_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1
