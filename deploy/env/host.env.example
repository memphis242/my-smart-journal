# /etc/msj/host.env (root:root 0644). Not secret: the name is in public DNS
# and the address is a private NetBird one. Read by caddy.service and the
# msj-* scripts.

# The journal's hostname (an A record pointing at MSJ_BIND_IP, DNS only).
MSJ_HOSTNAME=journal.example.com

# This box's NetBird IPv4 address: `ip -4 -o addr show wt0`. Caddy listens on
# it alone. Re-enrolling the peer changes it: update this, the A record, and
# restart caddy (msj-health reports the mismatch).
MSJ_BIND_IP=100.64.0.10

# The LUKS volume by UUID, which survives reattachment and device renaming:
# /dev/disk/by-uuid/$(cryptsetup luksUUID /dev/vdb)
MSJ_LUKS_DEVICE=/dev/disk/by-uuid/00000000-0000-0000-0000-000000000000
