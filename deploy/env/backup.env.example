# /srv/msj/secrets/backup.env (root:root 0600, on the encrypted volume). Read
# by msj-backup, msj-backup-verify and msj-restore-drill.
#
# restic over B2's S3-compatible API (restic's documented recommendation for
# B2). The endpoint region is in the bucket details, e.g. us-west-004.
RESTIC_REPOSITORY=s3:https://s3.us-west-004.backblazeb2.com/example-journal-backup/msj
RESTIC_PASSWORD_FILE=/srv/msj/secrets/restic-password
# B2 application key restricted to the one bucket, read and write.
AWS_ACCESS_KEY_ID=replace-me-keyID
AWS_SECRET_ACCESS_KEY=replace-me-applicationKey
