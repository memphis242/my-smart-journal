# /srv/msj/secrets/app.env (root:root 0600, on the encrypted volume). Read by
# systemd for msj-serve, msj-worker and msj-migrate, and by msj-cli.
# RunPod API key: in the RunPod console, Settings > API Keys, create a key
# restricted to Serverless (read/write) if offered. Only the worker uses it.
RUNPOD_API_KEY=replace-me
