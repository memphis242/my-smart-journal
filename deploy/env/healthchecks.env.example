# /etc/msj/healthchecks.env (root:root 0600, on the BOOT disk on purpose: a
# job refused because the volume is locked can still report why).
# One Healthchecks.io check per job; paste each check's ping URL.
# Suggested period / grace: health 5 min / 10 min; backup 1 day / 2 h;
# cert 1 day / 1 day; verify 7 days / 6 h; drill 31 days / 1 day.
HC_HEALTH_URL=https://hc-ping.com/replace-me-health
HC_BACKUP_URL=https://hc-ping.com/replace-me-backup
HC_VERIFY_URL=https://hc-ping.com/replace-me-verify
HC_DRILL_URL=https://hc-ping.com/replace-me-drill
HC_CERT_URL=https://hc-ping.com/replace-me-cert
