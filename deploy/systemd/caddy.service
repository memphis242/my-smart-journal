# Caddy: TLS front door for the journal, listening only on the box's NetBird
# address. The binary is built on the workstation with the DNS provider module
# (deploy/scripts/build-release.sh) and installed to /usr/local/bin/caddy,
# labelled httpd_exec_t so SELinux confines it as httpd_t (bootstrap.sh).
#
# Not enabled at boot: its certificate storage and DNS token are on the
# encrypted volume. msj.target (msj-unlock) starts it.
[Unit]
Description=Caddy TLS reverse proxy for the journal
Documentation=https://caddyserver.com/docs/
AssertPathIsMountPoint=/srv/msj
After=network-online.target netbird.service
Wants=network-online.target
PartOf=msj.target

[Service]
Type=notify
User=caddy
Group=caddy
# MSJ_HOSTNAME and MSJ_BIND_IP (boot disk), the DNS API token (encrypted volume).
EnvironmentFile=/etc/msj/host.env
EnvironmentFile=/srv/msj/secrets/caddy.env
Environment=XDG_DATA_HOME=/srv/msj/caddy XDG_CONFIG_HOME=/srv/msj/caddy/config
# No --environ: it would print the DNS API token into the journal.
ExecStart=/usr/local/bin/caddy run --config /etc/caddy/Caddyfile --adapter caddyfile
# The admin API is off, so there is no reload: systemctl restart caddy.
TimeoutStopSec=10s
Restart=on-failure
RestartSec=5
LimitNOFILE=65536
MemoryMax=256M
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
# NoNewPrivileges is deliberately not set: it can block the SELinux domain
# transition into httpd_t, which is the stronger confinement here.
UMask=0077
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/msj/caddy
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LimitCORE=0
