[Unit]
Description=My Smart Journal API and web UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=msj
Group=msj
EnvironmentFile=/etc/msj/service.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=HF_HOME=/var/lib/msj/models
ExecStart=/opt/msj/venv/bin/msj serve --host 127.0.0.1 --port 8765
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/msj

[Install]
WantedBy=multi-user.target
