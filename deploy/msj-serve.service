[Unit]
Description=My Smart Journal API and web UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=msj
Group=msj
EnvironmentFile=/etc/msj/service.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=HF_HOME=/var/lib/msj/models
Environment=HF_HUB_OFFLINE=1
ExecStart=/opt/msj/venv/bin/msj serve --host 127.0.0.1 --port 8765
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/msj
MemoryMax=2G
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallFilter=@system-service
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
PrivateDevices=true
ProtectProc=invisible
RestrictNamespaces=true
LockPersonality=true
RestrictSUIDSGID=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
