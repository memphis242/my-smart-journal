#!/usr/bin/env bash
#
# Health dead-man switch (msj-health.timer, every 5 minutes). Runs every check,
# then pings HC_HEALTH_URL with /0 when all pass or /1 with the list of
# failures, so one alert names everything that is wrong at once.
#
# Checks:
#   - the encrypted volume is unlocked and swap is on
#   - caddy, msj-serve and msj-worker are active
#   - the API answers on loopback, and through Caddy over TLS on the
#     NetBird address (proxy, certificate and app together)
#   - the worker heartbeat in journal.db is fresh
#   - the public A record still points at this box's NetBird address
#   - / and /srv/msj are below 85% full
#
# Run it by hand for a one-shot status report: msj-health
set -Eeuo pipefail
MSJ_JOB=msj-health
MSJ_UNIT=msj-health.service
# shellcheck source=lib/common.sh
. /usr/local/lib/msj/common.sh

readonly DISK_LIMIT_PCT=85
readonly HEARTBEAT_MAX_S=60

msj_require_root
msj_ping_on_exit HC_HEALTH_URL
msj_source_env "$MSJ_HOST_ENV"

failures=()
fail() { failures+=("$*"); msj_warn "$*"; }

if ! msj_is_unlocked; then
  # Nothing else can work while locked; say that, not ten consequences.
  msj_die "encrypted volume is locked ($MSJ_MOUNT not mounted), so the journal is down. Unlock it: ssh root@<host> then msj-unlock."
fi

swapon --show=NAME --noheadings | grep -qx "$MSJ_SWAPFILE" \
  || fail "swap $MSJ_SWAPFILE is not active (swapon $MSJ_SWAPFILE)"

for unit in caddy msj-serve msj-worker; do
  systemctl is-active --quiet "$unit" \
    || fail "$unit is $(systemctl is-active "$unit" || true) (journalctl -u $unit -n 50)"
done

curl -fsS -m 5 -o /dev/null "$MSJ_SERVE_URL/api/v1/health" \
  || fail "msj-serve does not answer $MSJ_SERVE_URL/api/v1/health"

wt0_ip=$(ip -4 -o addr show dev wt0 2>/dev/null | awk '{print $4}' | cut -d/ -f1 || true)
if [[ -z $wt0_ip ]]; then
  fail "wt0 has no IPv4 address: NetBird is down (netbird status)"
else
  [[ $wt0_ip == "$MSJ_BIND_IP" ]] \
    || fail "NetBird address is $wt0_ip but $MSJ_HOST_ENV says MSJ_BIND_IP=$MSJ_BIND_IP; the peer was re-enrolled. Update MSJ_BIND_IP and the DNS A record, then systemctl restart caddy"
  curl -fsS -m 10 -o /dev/null --resolve "$MSJ_HOSTNAME:443:$MSJ_BIND_IP" \
    "https://$MSJ_HOSTNAME/api/v1/health" \
    || fail "https://$MSJ_HOSTNAME/api/v1/health fails through Caddy on $MSJ_BIND_IP (journalctl -u caddy -n 50)"
  dns_ip=$(getent ahostsv4 "$MSJ_HOSTNAME" | awk 'NR==1{print $1}' || true)
  [[ $dns_ip == "$wt0_ip" ]] \
    || fail "DNS A record for $MSJ_HOSTNAME resolves to '${dns_ip:-nothing}', not this box's NetBird address $wt0_ip; fix the record at the DNS provider"
fi

seen=$(msj_db_query 'SELECT worker_last_seen_at FROM batch_state WHERE id=1;' 2>/dev/null || true)
if [[ -z $seen ]]; then
  fail "no worker heartbeat in journal.db (msj-worker never ran, or the database is unreadable)"
else
  age=$(( $(date -u +%s) - $(date -d "$seen" +%s) ))
  (( age <= HEARTBEAT_MAX_S )) \
    || fail "worker heartbeat is ${age}s old (limit ${HEARTBEAT_MAX_S}s); msj-worker is stuck or stopped (journalctl -u msj-worker -n 50)"
fi

for mount in / "$MSJ_MOUNT"; do
  pct=$(df --output=pcent "$mount" | tail -1 | tr -dc 0-9)
  (( pct < DISK_LIMIT_PCT )) || fail "$mount is ${pct}% full (limit ${DISK_LIMIT_PCT}%)"
done

if (( ${#failures[@]} > 0 )); then
  joined=$(printf '%s; ' "${failures[@]}")
  msj_die "${#failures[@]} check(s) failed: ${joined%; }"
fi
msj_ok_summary="all checks passed"
msj_log "$msj_ok_summary"
