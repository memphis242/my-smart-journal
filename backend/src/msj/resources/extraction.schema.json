{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JournalExtraction",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "projects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "skills_technologies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "accomplishments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string"
          },
          "metrics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "description",
          "metrics"
        ]
      }
    },
    "people_roles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "role"
        ]
      }
    },
    "star_fragments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "situation": {
            "type": "string"
          },
          "task": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "result": {
            "type": "string"
          }
        },
        "required": [
          "situation",
          "task",
          "action",
          "result"
        ]
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "projects",
    "skills_technologies",
    "accomplishments",
    "people_roles",
    "star_fragments",
    "tags"
  ]
}
