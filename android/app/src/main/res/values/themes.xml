<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window colors match the Compose paper background so no other color flashes before the first frame. -->
    <style name="Theme.Journal" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
