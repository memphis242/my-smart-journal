<?xml version="1.0" encoding="utf-8"?>
<!-- Release: HTTPS only, system certificate authorities only (the journal server
     uses a public Let's Encrypt certificate). No user-installed CAs, no cleartext. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
