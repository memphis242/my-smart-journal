<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_record"
        android:shortcutId="record"
        android:shortcutLongLabel="@string/shortcut_record_long"
        android:shortcutShortLabel="@string/shortcut_record_short">
        <intent
            android:action="dev.msj.journal.action.RECORD"
            android:targetClass="dev.msj.journal.MainActivity"
            android:targetPackage="${applicationId}" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_write"
        android:shortcutId="write"
        android:shortcutLongLabel="@string/shortcut_write_long"
        android:shortcutShortLabel="@string/shortcut_write_short">
        <intent
            android:action="dev.msj.journal.action.WRITE"
            android:targetClass="dev.msj.journal.MainActivity"
            android:targetPackage="${applicationId}" />
    </shortcut>
</shortcuts>
